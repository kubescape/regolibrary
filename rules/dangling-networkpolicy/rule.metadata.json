{
    "name": "dangling-networkpolicy",
    "attributes": {},
    "ruleLanguage": "Rego",
    "match": [
        {
            "apiGroups": ["networking.k8s.io"],
            "apiVersions": ["v1"],
            "resources": ["NetworkPolicy"]
        },
        {
            "apiGroups": [""],
            "apiVersions": ["v1"],
            "resources": ["Pod", "ReplicationController"]
        },
        {
            "apiGroups": ["apps"],
            "apiVersions": ["v1"],
            "resources": ["Deployment", "ReplicaSet", "DaemonSet", "StatefulSet"]
        },
        {
            "apiGroups": ["batch"],
            "apiVersions": ["*"],
            "resources": ["Job", "CronJob"]
        }
    ],
    "ruleDependencies": [],
    "description": "fails if a NetworkPolicy podSelector matches no workload in the same namespace",
    "remediation": "Verify the NetworkPolicy podSelector matches the labels of at least one workload in the same namespace, or remove the policy.",
    "ruleQuery": "armo_builtins"
}
